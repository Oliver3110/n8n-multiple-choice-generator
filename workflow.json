        -1232,
        480
      ],
      "name": "Noch Fragen?"
    },
    {
      "parameters": {
        "jsCode": "// Spielstand nach jeder Antwort fortschreiben\nconst s = $('Stand').last().json;                         // Stand vor dieser Frage\nconst q = $('AI Agent').last().json.output;               // die gerade gestellte Frage\nconst gewaehlt = ($('MC Fragen').last().json.Antwort || [])[0];\nconst richtig = gewaehlt === q.optionen[q.richtige_antwort];\n\nconst neu = { ...s };\nneu.punkte = s.punkte + (richtig ? 1 : 0);\n\n// nur im Modus Adaptiv: Stufe ±1, begrenzt auf 1 (Leicht) bis 3 (Schwer)\nif (s.adaptiv) {\n  neu.stufe = Math.min(3, Math.max(1, s.stufe + (richtig ? 1 : -1)));\n}\n\nneu.nr = s.nr + 1;                        // nächste Frage\nneu.bisher = [...s.bisher, q.frage];      // gegen Wiederholungen\nneu.letzte = richtig ? 'richtig' : 'falsch';\n\nreturn [{ json: neu }];"
      },
