    {
      "parameters": {
        "jsCode": "// Spielstand: beim ersten Durchlauf anlegen, danach aus der letzten Runde übernehmen\nconst STUFEN = ['Leicht', 'Mittel', 'Schwer'];\nlet s;\n\nif ($runIndex === 0) {\n  const e = $('Eingabe').first().json;\n  const wahl = String(e.Schwierigkeit || 'Adaptiv');\n  const adaptiv = wahl.startsWith('Adaptiv');\n  const fest = STUFEN.findIndex(st => wahl.startsWith(st)) + 1;   // 1–3, oder 0 wenn unbekannt\n  s = {\n    anzahl: Number(e['Anzahl Fragen']) || 5,\n    thema: String(e.Thema || '').trim() || 'Allgemeinwissen',     // leeres Thema abfangen\n    adaptiv,\n    stufe: adaptiv ? 1 : (fest || 2),\n    nr: 1,\n    punkte: 0,\n    bisher: []\n  };\n} else {\n  s = { ...$('Auswerten').last().json };\n}\n\ns.schwierigkeit = STUFEN[s.stufe - 1];\nreturn [{ json: s }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1392,
        480
      ],
      "name": "Stand"
    },
